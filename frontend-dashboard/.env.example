# Copy to `.env` and adjust. Vite only exposes variables prefixed with VITE_.

# Orchestrator API (Node 2 – Mac M4 Pro). Use the Tailscale MagicDNS name or 100.x IP.
VITE_ORCHESTRATOR_URL=http://localhost:8000
VITE_API_PREFIX=/api/v1
VITE_API_TIMEOUT_MS=15000

# Optional bearer token if the orchestrator gateway enforces auth.
VITE_API_TOKEN=

# true  -> use the built-in demo scenarios (no backend needed)
# false -> call the real orchestrator
VITE_USE_MOCKS=false
