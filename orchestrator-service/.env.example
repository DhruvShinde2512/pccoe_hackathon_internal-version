# Copy to .env to override defaults in config.py.

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<your-local-neo4j-password>

ML_SERVICE_URL=http://localhost:8001

# Profile A (single Mac):
LLM_BASE_URLS=http://localhost:8080
# Profile B (Windows GPU LLM first, Mac LLM as automatic fallback); use the Windows Tailscale IP:
# LLM_BASE_URLS=http://100.x.x.2:8080,http://localhost:8080
LLM_MODEL=qwen3.5-9b-instruct

# Two-machine layout (mentor-approved): Windows RTX = ML inference node + chat LLM; Mac = gateway,
# Neo4j, dashboard, narrative LLM. Use Tailscale MagicDNS names or 100.x addresses.
# ML_SERVICE_URL=http://<windows-tailscale-name>:8001
# Case assistant (chatbot): RTX first, Mac fallback.
CHAT_LLM_URLS=http://localhost:8080
# CHAT_LLM_URLS=http://<windows-tailscale-name>:8080,http://localhost:8080
CHAT_LLM_MODEL=qwen3.5-9b-chat

# /api/v1/admin/* (reset, recompute, fingerprint) are OFF by default. Enable only on a local
# demo/test machine (replay_script.py --reset/--verify and test_gateway.py need them):
ALLOW_ADMIN=false
